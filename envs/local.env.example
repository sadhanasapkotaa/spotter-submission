DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=spotter-local-secret-key
DATABASE_URL=postgis://spotter_local:spotter_local_pw@spotter-local-db:5432/spotter_local_db

# Read by the postgres container
POSTGRES_DB=spotter_local_db
POSTGRES_USER=spotter_local
POSTGRES_PASSWORD=spotter_local_pw
