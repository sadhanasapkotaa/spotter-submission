DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=spotter-prod-secret-key
DJANGO_ALLOWED_HOSTS=spotter.example.com,www.spotter.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://spotter.example.com,https://www.spotter.example.com
# true in real prod (TLS at the load balancer). Set false to try this stack on http://localhost:8003.
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_URL=postgres://spotter_prod:spotter_prod_pw@spotter-prod-db:5432/spotter_prod_db
WEB_CONCURRENCY=4
# `make env ENV=prod` replaces the secret key and DB password with random values.
# In real prod, inject secrets from a secret manager instead of a file.

POSTGRES_DB=spotter_prod_db
POSTGRES_USER=spotter_prod
POSTGRES_PASSWORD=spotter_prod_pw
