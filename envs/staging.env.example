DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=spotter-staging-secret-key
DJANGO_ALLOWED_HOSTS=staging.spotter.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.spotter.example.com
# Set to true once TLS terminates in front of the container.
DJANGO_SECURE_SSL_REDIRECT=false
DATABASE_URL=postgis://spotter_staging:spotter_staging_pw@spotter-staging-db:5432/spotter_staging_db
WEB_CONCURRENCY=3

POSTGRES_DB=spotter_staging_db
POSTGRES_USER=spotter_staging
POSTGRES_PASSWORD=spotter_staging_pw
